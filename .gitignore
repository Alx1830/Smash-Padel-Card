/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Catalogos crudos de TCGplayer: se regeneran con --refresh
scripts/tcgplayer-mapping/.cache/

# Cloudflare / OpenNext
.open-next/
.wrangler/
cloudflare-env.d.ts
cf-*.log

